[Unit]
Description=fleet admin (REST API + web UI)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=@ADMIN_USER@
Group=@ADMIN_GROUP@
Environment=HOME=@ADMIN_HOME@
EnvironmentFile=-@ENV_FILE@
ExecStart=@FLEET_BIN@ admin run --config @CONFIG_FILE@
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@ADMIN_STATE_DIR@
# The admin binds loopback by default. Put a reverse proxy, Tailscale Serve,
# or a tunnel in front of it instead of exposing this port directly.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
