[Unit]
Description=fleet machine daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@DAEMON_USER@
Group=@DAEMON_GROUP@
Environment=HOME=@DAEMON_HOME@
EnvironmentFile=-@ETC_DIR@/daemon.env
ExecStart=@BIN_DIR@/fleet-daemon --config @ETC_DIR@/daemon.toml serve
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
# Do not add ProtectSystem/ProtectHome here: agent sessions must write to the
# repositories and use the CLIs the daemon user owns. Sandboxing the agent is a
# separate, deliberate deployment decision.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
