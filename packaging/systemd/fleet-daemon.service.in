[Unit]
Description=fleet machine daemon
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=@DAEMON_USER@
Group=@DAEMON_GROUP@
Environment=HOME=@DAEMON_HOME@
EnvironmentFile=-@ENV_FILE@
ExecStart=@FLEET_BIN@ daemon run --config @CONFIG_FILE@
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
# Do not add ProtectSystem/ProtectHome here: agent sessions must write to the
# repositories and use the CLIs the daemon user owns. Sandboxing the agent is a
# separate, deliberate deployment decision.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
