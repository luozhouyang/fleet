# Agent Admin
AGENT_FLEET_ADMIN_TOKEN=dev-token
AGENT_FLEET_BIND=127.0.0.1:8787
AGENT_FLEET_DB=~/.agent-fleet/agent-admin.db

# Machine daemon
AGENT_FLEET_SERVER_URL=ws://127.0.0.1:8787/ws/machine
# Pair once with `af setup` (or set AGENT_FLEET_PAIR_CODE for automated
# provisioning). The per-machine token is stored in <key_file>.token.
AGENT_FLEET_DATA_DIR=~/.agent-fleet
AGENT_FLEET_MACHINE_NAME=dev-machine
