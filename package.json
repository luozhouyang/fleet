{
  "name": "agent-fleet",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "help": "echo \"build:rust build:release build:cli build:web test test:rust test:web fmt format lint dev dev:admin dev:daemon dev:web af web:install e2e e2e:api e2e:ui e2e:multi e2e:git docker:verify docker:verify:quick docker:verify:fresh install:local\"",
    "build": "pnpm run build:web",
    "build:rust": "${PCARGO:-/home/luozhouyang/Applications/pcargo/cargo} build --workspace",
    "build:release": "${PCARGO:-/home/luozhouyang/Applications/pcargo/cargo} build --workspace --release",
    "build:web": "pnpm --filter @agent-fleet/web build",
    "build:cli": "${PCARGO:-/home/luozhouyang/Applications/pcargo/cargo} build -p fleet-cli",
    "test": "pnpm run test:rust && pnpm run test:web",
    "test:rust": "${PCARGO:-/home/luozhouyang/Applications/pcargo/cargo} test --workspace",
    "test:web": "pnpm --filter @agent-fleet/web exec tsc -p tsconfig.app.json --noEmit && pnpm --filter @agent-fleet/web lint",
    "fmt": "${PCARGO:-/home/luozhouyang/Applications/pcargo/cargo} fmt --all && pnpm -r --if-present format",
    "format": "pnpm -r --if-present format",
    "lint": "${PCARGO:-/home/luozhouyang/Applications/pcargo/cargo} clippy --workspace --all-targets -- -D warnings && pnpm -r --if-present lint",
    "dev": "VITE_DEFAULT_API_TOKEN=${AGENT_FLEET_ADMIN_TOKEN:-dev-token} pnpm run build:web && pnpm run dev:admin",
    "dev:admin": "AGENT_FLEET_ADMIN_TOKEN=${AGENT_FLEET_ADMIN_TOKEN:-dev-token} AGENT_FLEET_MACHINE_TOKEN=${AGENT_FLEET_MACHINE_TOKEN:-dev-machine-token} ${PCARGO:-/home/luozhouyang/Applications/pcargo/cargo} run -p fleet-admin --bin agent-admin -- serve",
    "dev:daemon": "${PCARGO:-/home/luozhouyang/Applications/pcargo/cargo} run -p fleet-daemon -- serve",
    "dev:web": "VITE_DEFAULT_API_TOKEN=${AGENT_FLEET_ADMIN_TOKEN:-dev-token} pnpm --filter @agent-fleet/web dev",
    "af": "${PCARGO:-/home/luozhouyang/Applications/pcargo/cargo} run -q -p fleet-cli --bin af",
    "web:install": "pnpm install",
    "e2e": "pnpm run e2e:api",
    "e2e:api": "./scripts/test/e2e_smoke.sh",
    "e2e:ui": "./scripts/test/ui_e2e.sh",
    "e2e:multi": "./scripts/test/multi_machine_stress.sh",
    "e2e:git": "./scripts/test/git_write_e2e.sh",
    "docker:verify": "./scripts/test/docker_verify.sh all",
    "docker:verify:quick": "./scripts/test/docker_verify.sh quick",
    "docker:verify:fresh": "./scripts/test/docker_verify.sh fresh",
    "install:local": "./scripts/install/install.sh"
  }
}
